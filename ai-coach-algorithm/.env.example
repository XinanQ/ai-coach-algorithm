AI_COACH_EMBEDDING_BACKEND=sentence_transformers
AI_COACH_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
AI_COACH_HASH_EMBEDDING_DIM=384
AI_COACH_CHROMA_MAX_QUERY_RESULTS=80

AI_COACH_SHORT_MEMORY_BACKEND=auto
AI_COACH_LONG_MEMORY_BACKEND=auto
AI_COACH_REDIS_URL=redis://localhost:6379/0
AI_COACH_POSTGRES_DSN=postgresql://ai_coach:ai_coach_dev@localhost:5432/ai_coach

AI_COACH_SESSION_TTL_SECONDS=86400
AI_COACH_BERT_MINI_MODEL=uer/chinese_roberta_L-2_H-128

AI_COACH_API_PORT=8000
AI_COACH_REDIS_PORT=6379
AI_COACH_POSTGRES_PORT=5432
AI_COACH_PYTHON_IMAGE=python:3.11-slim
AI_COACH_DOCKER_EMBEDDING_BACKEND=hash
AI_COACH_DOCKER_EMBEDDING_MODEL=local_hash_embedding_v1
AI_COACH_SCORER=llm
AI_COACH_CUSTOMER_LLM=llm
AI_COACH_LLM_MODEL=deepseek-chat
AI_COACH_LLM_TIMEOUT=20
DEEPSEEK_API_KEY=

# 评分/客户 LLM 细粒度调参（默认值即生产建议值）
AI_COACH_SCORER_TEMPERATURE=0.0
AI_COACH_SCORER_MAX_TOKENS=800
AI_COACH_CUSTOMER_MAX_TOKENS=300
# 客户追问独立超时(秒)：超时不重试，直接落模板兜底；0=用全局超时
AI_COACH_CUSTOMER_LLM_TIMEOUT=10
# LLM 漏判合规红线时的程序化压分闸门；0 关闭（仅用于 A/B 对照）
AI_COACH_REDLINE_CROSS_CHECK=1
# /dialog/start 时预热该画像的 DeepSeek prefix cache，降低首轮 reply 延迟
AI_COACH_PREFIX_WARMUP=1
