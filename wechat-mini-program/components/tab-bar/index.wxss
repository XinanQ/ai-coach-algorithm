.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  border-top: 1rpx solid #E4E4E4;
}
.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tab-text {
  font-size: 24rpx;
  color: #9A9CA4;
}
.tab-active .tab-text {
  color: #111111;
  font-weight: 600;
}
