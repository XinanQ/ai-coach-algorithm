page {
  background: var(--bg);
}
.page {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}
.my-rank {
  margin-bottom: 32rpx;
}
.my-rank-label {
  font-size: 24rpx;
  opacity: 0.7;
  letter-spacing: 2rpx;
}
.my-rank-main {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 16rpx;
}
.my-rank-no {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}
.my-rank-score {
  font-size: 30rpx;
  opacity: 0.85;
}
.tabs {
  display: flex;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
}
.tab.active {
  color: #fff;
  background: var(--primary);
}
.list {
  border-top: 1rpx solid var(--border);
}
.row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.rank {
  width: 72rpx;
  font-size: 32rpx;
  font-weight: 700;
}
.name {
  flex: 1;
  font-size: 30rpx;
}
.score {
  font-size: 28rpx;
  color: var(--text-secondary);
}
