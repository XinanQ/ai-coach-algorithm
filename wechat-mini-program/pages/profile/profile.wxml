<view class="page">
  <view class="page-head">
    <text class="eyebrow">账户</text>
    <text class="big-title">我的</text>
  </view>

  <view class="hero-card user-card" hover-class="card-hover" bindtap="goAccount">
    <view class="avatar">{{userName[0]}}</view>
    <view class="info">
      <text class="name">{{userName}}</text>
      <text class="branch">{{branch}} · {{roleLabel}}</text>
    </view>
    <text class="card-arrow">></text>
  </view>

  <!-- 员工菜单 -->
  <view class="menu" wx:if="{{role !== 'manager'}}">
    <view class="menu-item" bindtap="goHistory">
      <text>业绩上报历史</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="goPracticeHistory">
      <text>陪练历史成绩</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="goNews">
      <text>喜报记录</text>
      <text class="arrow">></text>
    </view>
  </view>

  <!-- 管理员菜单 -->
  <view class="menu" wx:else>
    <view class="menu-item" bindtap="goAnalysis">
      <text>团队数据分析</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="goEmployees">
      <text>员工管理</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="goTaskLib">
      <text>任务库</text>
      <text class="arrow">></text>
    </view>
  </view>

  <button class="ghost-btn" hover-class="ghost-hover" bindtap="switchRole">切换角色</button>
  <button class="logout-btn" hover-class="logout-btn-hover" bindtap="logout">退出登录</button>
</view>

<tab-bar active="profile" />
