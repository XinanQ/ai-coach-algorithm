page {
  background: var(--bg);
}
.head {
  padding: 48rpx 0 28rpx;
  border-bottom: 1rpx solid var(--border);
  margin-bottom: 32rpx;
}
.title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.15;
  margin-top: 12rpx;
}
.meta {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 20rpx;
}
.image {
  width: 100%;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}
.content {
  font-size: 30rpx;
  line-height: 1.8;
  color: var(--text);
}
.save-btn {
  margin-top: 56rpx;
}
