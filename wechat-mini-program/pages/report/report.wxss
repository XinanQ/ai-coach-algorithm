page {
  background: var(--bg);
}

.role-hint {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #f4f4f4;
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 1.6;
}

.field {
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.field:first-of-type {
  border-top: 1rpx solid var(--border);
}

.field-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}

.field-value {
  min-height: 56rpx;
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
}

.field-value text:first-child {
  flex: 1;
}

.placeholder,
.field-input {
  color: var(--text-secondary);
}

.caret {
  color: var(--text);
  flex: none;
}

.field-input {
  width: 100%;
  min-height: 56rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.attachment-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.attachment-img,
.file-icon,
.upload-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
}

.attachment-img {
  background: var(--surface-2);
}

.file-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-2);
  color: var(--text-secondary);
  font-size: 48rpx;
  font-weight: 700;
}

.attachment-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.attachment-name {
  max-width: 440rpx;
  color: var(--text);
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.attachment-remove {
  color: #d92d20;
  font-size: 24rpx;
}

.upload-add {
  border: 1rpx dashed var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
}

.plus {
  color: var(--text-secondary);
  font-size: 60rpx;
}

.submit-btn {
  margin-top: 48rpx;
}
