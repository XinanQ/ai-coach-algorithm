page {
  background: var(--bg);
}
.field {
  padding: 32rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.field:first-of-type {
  border-top: 1rpx solid var(--border);
}
.field-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}
.field-value {
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.caret {
  color: var(--text);
}
.field-input {
  font-size: 34rpx;
  font-weight: 600;
}
.upload-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.upload-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}
.upload-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
}
.upload-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: rgba(0,0,0,0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
}
.upload-add {
  width: 160rpx;
  height: 160rpx;
  border: 1rpx dashed var(--border);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: var(--text-secondary);
}
.submit-btn {
  margin-top: 48rpx;
}
