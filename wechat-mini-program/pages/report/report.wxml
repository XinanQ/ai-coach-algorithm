<view class="page">
  <view class="page-head">
    <text class="eyebrow">今日</text>
    <text class="big-title">业绩上报</text>
  </view>

  <view class="role-hint" wx:if="{{blockedByRole}}">{{blockedText}}</view>

  <view class="field">
    <text class="field-label">项目</text>
    <picker mode="selector" range="{{projects}}" range-key="name" value="{{projectIndex}}" disabled="{{blockedByRole || loading}}" bindchange="onProjectChange">
      <view class="field-value {{projectIndex < 0 ? 'placeholder' : ''}}">
        <text>{{projectName}}</text>
        <text class="caret">></text>
      </view>
    </picker>
  </view>

  <view class="field">
    <text class="field-label">指标</text>
    <picker mode="selector" range="{{indicators}}" range-key="name" value="{{indicatorIndex}}" disabled="{{blockedByRole || projectIndex < 0}}" bindchange="onIndicatorChange">
      <view class="field-value {{indicatorIndex < 0 ? 'placeholder' : ''}}">
        <text>{{indicatorName}}</text>
        <text class="caret">></text>
      </view>
    </picker>
  </view>

  <view class="field">
    <text class="field-label">上报日期</text>
    <picker mode="date" value="{{reportDate}}" disabled="{{blockedByRole}}" bindchange="onDateChange">
      <view class="field-value">
        <text>{{reportDate}}</text>
        <text class="caret">></text>
      </view>
    </picker>
  </view>

  <view class="field">
    <text class="field-label">{{amountLabel}}</text>
    <input class="field-input" type="digit" disabled="{{blockedByRole}}" placeholder="请输入数量" value="{{amount}}" bindinput="onAmountInput" />
  </view>

  <view class="field">
    <text class="field-label">附件</text>
    <view class="attachment-row" wx:if="{{attachment}}">
      <image wx:if="{{attachment.type === 'image'}}" src="{{attachment.path}}" mode="aspectFill" class="attachment-img" />
      <view wx:else class="file-icon">文</view>
      <view class="attachment-info">
        <text class="attachment-name">{{attachment.name}}</text>
        <text class="attachment-remove" bindtap="removeAttachment">移除</text>
      </view>
    </view>
    <view class="upload-add" bindtap="chooseAttachment" wx:else>
      <text class="plus">+</text>
    </view>
  </view>

  <button class="btn-primary submit-btn" loading="{{submitting}}" disabled="{{blockedByRole || submitting}}" bindtap="submit">
    {{submitting ? '提交中' : '提交上报'}}
  </button>
</view>
