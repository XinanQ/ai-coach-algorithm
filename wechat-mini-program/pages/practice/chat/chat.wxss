page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: var(--gradient);
  color: #fff;
}
.topbar-scene {
  font-size: 26rpx;
  opacity: 0.85;
}
.topbar-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.timer {
  font-size: 26rpx;
  opacity: 0.7;
}
.chat-area {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}
.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
}
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #fff;
}
.avatar-ai {
  background: var(--accent);
  margin-right: 16rpx;
}
.avatar-user {
  background: var(--primary);
  margin-left: 16rpx;
}
.msg-ai {
  justify-content: flex-start;
}
.msg-user {
  justify-content: flex-end;
}
.bubble {
  max-width: 70%;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1.5;
}
.msg-ai .bubble {
  background: var(--surface);
  color: var(--text);
  border: 1rpx solid var(--border);
}
.msg-user .bubble {
  background: var(--primary);
  color: #fff;
}
.dialog-actions {
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx;
  background: var(--surface);
  border-top: 1rpx solid var(--border);
}
.end-link {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--text-secondary);
}
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 1rpx solid var(--border);
}
.mic {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--surface-2);
  color: var(--text);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.input {
  flex: 1;
  background: var(--surface-2);
  color: var(--text);
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
}
.placeholder {
  color: var(--text-secondary);
}
.send-btn {
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
  padding: 0 24rpx;
  line-height: 70rpx;
  height: 70rpx;
}
.send-btn::after {
  border: none;
}
