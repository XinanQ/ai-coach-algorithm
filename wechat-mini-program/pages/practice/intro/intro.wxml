<view class="container">
  <view class="hero">
    <text class="scene-label">陪练场景</text>
    <text class="scene-title">{{title || scene}}</text>
    <view class="scene-meta">
      <text wx:if="{{scene && scene !== title}}">{{scene}}</text>
      <text wx:if="{{difficulty}}">{{difficulty}}</text>
      <text>共 {{rounds}} 轮对话</text>
    </view>
  </view>

  <view class="block">
    <text class="block-title">AI 客户角色</text>
    <view class="customer">
      <view class="customer-avatar">{{customerName[0]}}</view>
      <view class="customer-info">
        <text class="customer-name">{{customerName}}</text>
        <text class="customer-desc">{{customerDesc}}</text>
      </view>
    </view>
    <view class="tags">
      <text class="tag" wx:for="{{tags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="block">
    <text class="block-title">场景背景</text>
    <text class="block-text">{{background}}</text>
  </view>

  <view class="block">
    <text class="block-title">本次目标</text>
    <text class="block-text">{{goal}}</text>
  </view>

  <view class="block" wx:if="{{requirements.length > 0}}">
    <text class="block-title">完成要求</text>
    <view class="req-wrap">
      <view class="req-list">
        <view class="req" wx:for="{{requirements}}" wx:key="*this">
          <text class="req-dot"></text>
          <text class="req-text">{{item}}</text>
        </view>
        <text class="req-duration" wx:if="{{duration}}">预计时长 {{duration}}</text>
      </view>
      <view class="prog-ring" style="background: conic-gradient(var(--primary) {{progress}}%, var(--surface-2) {{progress}}%);">
        <view class="prog-inner">
          <text class="prog-val">{{progress}}%</text>
          <text class="prog-label">进度</text>
        </view>
      </view>
    </view>
  </view>

  <view class="footer">
    <button class="ghost-btn" wx:if="{{scriptId}}" bindtap="viewStandard">查看标准话术</button>
    <button class="start-btn" bindtap="startPractice">开始陪练</button>
  </view>
</view>
