page {
  background: var(--bg);
}
.container {
  padding: 0 32rpx 180rpx;
}
.hero {
  background: var(--gradient);
  margin: 0 -32rpx 32rpx;
  padding: 56rpx 32rpx 64rpx;
  display: flex;
  flex-direction: column;
  color: #fff;
}
.scene-label {
  font-size: 24rpx;
  opacity: 0.7;
  letter-spacing: 2rpx;
}
.scene-title {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  margin-top: 12rpx;
}
.rounds {
  font-size: 26rpx;
  opacity: 0.8;
  margin-top: 16rpx;
}
.block {
  border-top: 1rpx solid var(--border);
  padding: 32rpx 0;
}
.block-title {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 20rpx;
}
.block-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text);
}
.customer {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.customer-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.customer-info {
  display: flex;
  flex-direction: column;
}
.customer-name {
  font-size: 34rpx;
  font-weight: 700;
}
.customer-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tag {
  font-size: 24rpx;
  color: var(--text);
  border: 1rpx solid var(--text);
  border-radius: 100rpx;
  padding: 8rpx 24rpx;
}
/* 完成要求 + 进度环 */
.req-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}
.req-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.req {
  display: flex;
  align-items: center;
}
.req-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--primary);
  margin-right: 16rpx;
}
.req-text {
  font-size: 28rpx;
}
.req-duration {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}
.prog-ring {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.prog-inner {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--surface);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.prog-val {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1;
}
.prog-label {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 1rpx solid var(--border);
}
.ghost-btn {
  flex: 1;
  background: var(--surface-2);
  color: var(--text);
  border-radius: 8rpx;
  font-size: 30rpx;
}
.ghost-btn::after {
  border: none;
}
.start-btn {
  flex: 1;
  background: var(--primary);
  color: #fff;
  border-radius: 8rpx;
  font-size: 32rpx;
}
.start-btn::after {
  border: none;
}
