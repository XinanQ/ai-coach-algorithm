page {
  background: var(--bg);
}
.score-card {
  background: var(--gradient);
  border-radius: 8rpx;
  padding: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 32rpx;
  color: #fff;
}
.score-ring {
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.score-ring-inner {
  width: 210rpx;
  height: 210rpx;
  border-radius: 50%;
  background: var(--accent);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.score {
  font-size: 76rpx;
  font-weight: 700;
  color: #fff;
}
.score-label {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}
.block {
  border-top: 1rpx solid var(--border);
  padding: 36rpx 0;
}
.block-title {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
  margin-bottom: 28rpx;
}
.block-content {
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.7;
}

/* 分项评分 */
.dim-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.dim-row:last-child {
  margin-bottom: 0;
}
.dim-label {
  width: 110rpx;
  font-size: 26rpx;
  color: var(--text);
}
.dim-bar {
  flex: 1;
  height: 14rpx;
  background: var(--surface-2);
  border-radius: 8rpx;
  margin: 0 16rpx;
  overflow: hidden;
}
.dim-bar-fill {
  height: 100%;
  background: var(--primary);
  border-radius: 8rpx;
}
.dim-value {
  width: 52rpx;
  text-align: right;
  font-size: 26rpx;
  color: var(--text);
  font-weight: 700;
}
.dim-level {
  width: 64rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 薄弱项 */
.weak-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.weak-tag {
  padding: 10rpx 20rpx;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--text);
  background: var(--surface-2);
}
.result-source {
  font-size: 22rpx;
  color: var(--text-secondary);
  padding: 12rpx 0 28rpx;
}
.result-error {
  min-height: 60vh;
  padding: 80rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: var(--text-secondary);
  font-size: 28rpx;
}

/* 操作 */
.actions {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.act-primary {
  background: var(--primary);
  color: #fff;
  border-radius: 8rpx;
  font-size: 32rpx;
  height: 96rpx;
  line-height: 96rpx;
}
.act-primary::after {
  border: none;
}
.act-row {
  display: flex;
  gap: 20rpx;
}
.act-ghost {
  flex: 1;
  background: var(--surface-2);
  color: var(--text);
  border-radius: 8rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
}
.act-ghost::after {
  border: none;
}
