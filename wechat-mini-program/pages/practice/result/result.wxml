<view class="page" wx:if="{{hasResult}}">
  <view class="score-card">
    <view class="score-ring" style="background: conic-gradient(#fff {{score}}%, rgba(255,255,255,0.25) {{score}}%)">
      <view class="score-ring-inner">
        <text class="score">{{score}}</text>
        <text class="score-label">本次得分</text>
      </view>
    </view>
  </view>

  <view class="block" wx:if="{{dimensionScores.length > 0}}">
    <text class="block-title">分项评分</text>
    <view class="dim-row" wx:for="{{dimensionScores}}" wx:key="name">
      <text class="dim-label">{{item.name}}</text>
      <view class="dim-bar">
        <view class="dim-bar-fill" style="width: {{item.score}}%"></view>
      </view>
      <text class="dim-value">{{item.score}}</text>
      <text class="dim-level">{{item.level}}</text>
    </view>
  </view>

  <view class="block" wx:if="{{weakTags.length > 0}}">
    <text class="block-title">薄弱项</text>
    <view class="weak-tags">
      <text class="weak-tag" wx:for="{{weakTags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="block" wx:if="{{suggestion}}">
    <text class="block-title">改进建议</text>
    <text class="block-content">{{suggestion}}</text>
  </view>

  <view class="result-source" wx:if="{{source}}">source: {{source}}</view>

  <view class="actions">
    <button class="act-primary" bindtap="goReview">复盘提升 · 收藏话术</button>
    <view class="act-row">
      <button class="act-ghost" bindtap="retry">再练一次</button>
      <button class="act-ghost" bindtap="nextLevel">挑战下一关</button>
    </view>
  </view>
</view>

<view class="result-error" wx:else>
  <text>未找到本次陪练结果，请重新完成陪练</text>
</view>
