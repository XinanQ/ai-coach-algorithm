page {
  background: var(--bg);
}
.page {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}
.head-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}
.link {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 成长卡 */
.growth-card {
  margin-bottom: 32rpx;
}
.growth-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.growth-level {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}
.growth-sub {
  display: block;
  font-size: 22rpx;
  opacity: 0.7;
  margin-top: 12rpx;
}
.growth-points {
  font-size: 26rpx;
  opacity: 0.85;
}
.growth-bar {
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.25);
  margin-top: 28rpx;
  overflow: hidden;
}
.growth-bar-fill {
  height: 100%;
  background: #fff;
  border-radius: 999rpx;
}

/* 分类切换 */
.seg {
  display: flex;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
}
.seg-item.active {
  color: #fff;
  background: var(--primary);
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 上级下发任务 */
.task {
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  padding: 28rpx;
}
.task-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.badge {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.badge-must {
  background: var(--primary);
  color: #fff;
}
.badge-recommend {
  background: var(--surface-2);
  color: var(--text);
  border: 1rpx solid var(--border);
}
.task-status {
  font-size: 22rpx;
  color: var(--text-secondary);
}
.task-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.45;
}
.task-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}
.task-tag {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--surface-2);
  color: var(--text-secondary);
  font-size: 20rpx;
}
.task-meta {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 20rpx;
  margin-top: 16rpx;
}
.task-context {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.task-scene {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.task-difficulty {
  font-size: 22rpx;
  color: var(--text-secondary);
  border-left: 1rpx solid var(--border);
  padding-left: 12rpx;
}
.task-deadline {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 通用任务库 / 已完成 */
.lib,
.done {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
}
.lib-left,
.done-left {
  display: flex;
  flex-direction: column;
}
.lib-name,
.done-name {
  font-size: 30rpx;
  font-weight: 600;
}
.lib-meta,
.done-meta {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 10rpx;
}
.done-score {
  font-size: 30rpx;
  font-weight: 700;
}
.arrow {
  color: var(--text);
  font-size: 30rpx;
}

.empty {
  text-align: center;
  color: var(--text-secondary);
  font-size: 26rpx;
  padding: 60rpx 0;
}
