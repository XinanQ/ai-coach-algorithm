<view class="page">
  <view class="page-head head-row">
    <view>
      <text class="eyebrow">陪练任务</text>
      <text class="big-title">任务</text>
    </view>
    <text class="link" bindtap="goHistory">历史成绩 ></text>
  </view>

  <!-- 成长卡 -->
  <view class="hero-card growth-card" wx:if="{{hasGrowth}}">
    <view class="growth-top">
      <view class="growth-left">
        <text class="growth-level">{{growth.levelName}}</text>
        <text class="growth-sub">连续练习 {{growth.streakDays}} 天 · 本周 +{{growth.weekGain}}</text>
      </view>
      <text class="growth-points">{{growth.points}}/{{growth.target}}</text>
    </view>
    <view class="growth-bar">
      <view class="growth-bar-fill" style="width: {{growthPercent}}%"></view>
    </view>
  </view>

  <!-- 任务分类 -->
  <view class="seg">
    <view class="seg-item {{activeTab === index ? 'active' : ''}}" wx:for="{{segs}}" wx:key="*this" data-index="{{index}}" bindtap="switchSeg">{{item}}</view>
  </view>

  <!-- 任务列表（按当前 tab 拉取，统一结构）-->
  <view class="list">
    <view class="task" wx:for="{{list}}" wx:key="taskId" data-id="{{item.taskId}}" bindtap="goTask">
      <view class="task-head">
        <text class="badge {{item.level === 'must' ? 'badge-must' : 'badge-recommend'}}">{{item.level === 'must' ? '必须完成' : '强烈推荐'}}</text>
        <text class="task-status">{{item.statusLabel}}</text>
      </view>
      <text class="task-name">{{item.displayTitle || item.title}}</text>
      <view class="task-tags" wx:if="{{item.tags && item.tags.length > 0}}">
        <text class="task-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
      </view>
      <view class="task-meta">
        <view class="task-context">
          <text class="task-scene" wx:if="{{item.scene}}">{{item.scene}}</text>
          <text class="task-difficulty" wx:if="{{item.difficulty}}">{{item.difficulty}}</text>
        </view>
        <text class="task-deadline" wx:if="{{item.deadline || item.rewardPoints != null}}">
          {{item.deadline ? '截止 ' + item.deadline : ''}}{{item.deadline && item.rewardPoints != null ? ' · ' : ''}}{{item.rewardPoints != null ? '+' + item.rewardPoints + '积分' : ''}}
        </text>
      </view>
    </view>
    <view class="empty" wx:if="{{list.length === 0}}">暂无任务</view>
  </view>
</view>

<tab-bar active="task" />
