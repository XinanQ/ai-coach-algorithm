page {
  background: var(--bg);
}
.list {
  border-top: 1rpx solid var(--border);
}
.row {
  padding: 32rpx 0;
  border-bottom: 1rpx solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.row-left {
  display: flex;
  flex-direction: column;
}
.scene {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}
.date {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 10rpx;
}
.score {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}
.score-unit {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-secondary);
  margin-left: 4rpx;
}
.empty {
  text-align: center;
  color: var(--text-secondary);
  margin-top: 100rpx;
}
