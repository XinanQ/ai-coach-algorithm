page {
  background: var(--bg);
}
.page {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}
.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
}
.row-main {
  flex: 1;
}
.title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 14rpx 0;
}
.tag {
  font-size: 20rpx;
  color: var(--text-secondary);
  background: var(--surface-2);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}
.meta {
  font-size: 22rpx;
  color: var(--text-secondary);
}
.arrow {
  color: var(--text);
  font-size: 30rpx;
  margin-left: 16rpx;
}
.empty {
  text-align: center;
  color: var(--text-secondary);
  font-size: 26rpx;
  padding: 80rpx 40rpx;
  line-height: 1.6;
}
