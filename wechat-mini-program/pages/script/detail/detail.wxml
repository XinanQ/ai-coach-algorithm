<view class="page">
  <view class="page-head">
    <text class="eyebrow" wx:if="{{detail.businessName || detail.scene}}">
      {{detail.businessName}}{{detail.businessName && detail.scene ? ' · ' : ''}}{{detail.scene}}
    </text>
    <text class="big-title">{{detail.title || detail.chunkId || detail.scriptId}}</text>
  </view>

  <text class="source-name" wx:if="{{detail.sourceName}}">{{detail.sourceName}}</text>

  <view class="hero-card std" wx:if="{{displayContent}}">
    <text class="std-tag">话术内容</text>
    <text class="std-text">{{displayContent}}</text>
  </view>

  <button class="btn-primary copy-btn" wx:if="{{displayContent}}" bindtap="copy">复制话术内容</button>
</view>
