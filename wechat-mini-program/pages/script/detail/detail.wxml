<view class="page">
  <view class="page-head">
    <text class="eyebrow">{{detail.scene}}</text>
    <text class="big-title">{{detail.title}}</text>
  </view>

  <view class="tags">
    <text class="tag" wx:for="{{detail.tags}}" wx:key="*this">{{item}}</text>
  </view>

  <view class="hero-card std">
    <text class="std-tag">标准话术</text>
    <text class="std-text">{{detail.standard}}</text>
  </view>

  <view class="block" wx:if="{{!standardOnly}}">
    <text class="block-title">我的优化话术</text>
    <text class="block-text">{{detail.mine}}</text>
  </view>

  <button class="btn-primary copy-btn" bindtap="copy">复制标准话术</button>
</view>
