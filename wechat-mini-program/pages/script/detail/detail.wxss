page {
  background: var(--bg);
}
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.tag {
  font-size: 22rpx;
  color: var(--text);
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}
.std-tag {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 2rpx;
  margin-bottom: 18rpx;
}
.std-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #fff;
}
.block {
  border-top: 1rpx solid var(--border);
  margin-top: 32rpx;
  padding: 32rpx 0;
}
.block-title {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
  margin-bottom: 18rpx;
}
.block-text {
  font-size: 28rpx;
  line-height: 1.7;
}
.copy-btn {
  margin-top: 24rpx;
  height: 96rpx;
  line-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.copy-btn::after {
  border: none;
}
