page {
  background: var(--bg);
}
.big-title {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  font-size: 42rpx;
  line-height: 1.3;
  letter-spacing: 0;
}
.source-name {
  display: block;
  margin-bottom: 24rpx;
  color: var(--text-secondary);
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.std-tag {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 2rpx;
  margin-bottom: 18rpx;
}
.std-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #fff;
}
.copy-btn {
  margin-top: 24rpx;
  height: 96rpx;
  line-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.copy-btn::after {
  border: none;
}
