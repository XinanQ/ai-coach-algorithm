page {
  background: var(--bg);
}
.page {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}
.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.filter {
  font-size: 24rpx;
  color: var(--text);
  background: var(--surface-2);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
}
.stats {
  display: flex;
  flex-wrap: wrap;
}
.stat {
  width: 50%;
  box-sizing: border-box;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
}
.stat-val {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}
.stat-label {
  font-size: 24rpx;
  opacity: 0.75;
  margin-top: 6rpx;
}
.stat-delta {
  font-size: 20rpx;
  opacity: 0.6;
  margin-top: 6rpx;
}
.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin: 36rpx 0 20rpx;
}
.rank-head {
  display: flex;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border);
}
.rh {
  font-size: 22rpx;
  color: var(--text-secondary);
}
.rh-rank {
  width: 80rpx;
}
.rh-name {
  flex: 1;
}
.rh-rate {
  width: 120rpx;
  text-align: right;
}
.rh-score {
  width: 120rpx;
  text-align: right;
}
.rank-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.rc-rank {
  width: 80rpx;
  font-size: 30rpx;
  font-weight: 700;
}
.rc-name {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.rn {
  font-size: 28rpx;
  font-weight: 600;
}
.rd {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}
.rc-rate {
  width: 120rpx;
  text-align: right;
  font-size: 26rpx;
}
.rc-score {
  width: 120rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 700;
}
.assign-btn {
  margin-top: 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.assign-btn::after {
  border: none;
}
