<view class="page">
  <view class="page-head">
    <text class="eyebrow">{{emp.dept}}</text>
    <text class="big-title">{{emp.name}}</text>
  </view>

  <view class="hero-card summary">
    <view class="s">
      <text class="sv">{{emp.rate}}%</text>
      <text class="sl">完成率</text>
    </view>
    <view class="s">
      <text class="sv">{{emp.score}}</text>
      <text class="sl">最近得分</text>
    </view>
  </view>

  <text class="section-title">任务进度</text>
  <view class="tlist">
    <view class="trow" wx:for="{{emp.tasks}}" wx:key="name">
      <view class="tinfo">
        <text class="tname">{{item.name}}</text>
        <text class="tstatus">{{item.status}}</text>
      </view>
      <text class="tscore">{{item.scoreText}}</text>
    </view>
  </view>

  <button class="btn-primary re-btn" bindtap="reassign">下发二次训练</button>
</view>
