page {
  background: var(--bg);
}
.summary {
  display: flex;
  margin-top: 8rpx;
}
.s {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.sv {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}
.sl {
  font-size: 24rpx;
  opacity: 0.75;
  margin-top: 6rpx;
}
.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin: 40rpx 0 12rpx;
}
.tlist {
  border-top: 1rpx solid var(--border);
}
.trow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.tinfo {
  display: flex;
  flex-direction: column;
}
.tname {
  font-size: 30rpx;
  font-weight: 600;
}
.tstatus {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}
.tscore {
  font-size: 30rpx;
  font-weight: 700;
}
.re-btn {
  margin-top: 40rpx;
  height: 96rpx;
  line-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.re-btn::after {
  border: none;
}
