<view class="page">
  <view class="page-head head-row">
    <view>
      <text class="eyebrow">陪练模板</text>
      <text class="big-title">任务库</text>
    </view>
    <text class="link" bindtap="goAssign">+ 下发</text>
  </view>

  <view class="list">
    <view class="row" wx:for="{{templates}}" wx:key="id" bindtap="goAssign">
      <view class="row-main">
        <text class="name">{{item.name}}</text>
        <text class="meta">{{item.scene}} · {{item.dimensions}} 个评分维度</text>
      </view>
      <text class="go">下发 ></text>
    </view>
  </view>
</view>

<tab-bar active="tasklib" />
