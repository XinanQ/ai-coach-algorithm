<view class="page">
  <view class="page-head">
    <text class="eyebrow">本网点</text>
    <text class="big-title">员工管理</text>
  </view>

  <view class="list">
    <view class="emp" wx:for="{{employees}}" wx:key="employeeId" data-id="{{item.employeeId}}" bindtap="goDetail">
      <view class="emp-top">
        <view class="emp-id">
          <text class="emp-name">{{item.name}}</text>
          <text class="emp-dept">{{item.position}}</text>
        </view>
        <text class="emp-score">{{item.score}}分</text>
      </view>
      <view class="emp-bar">
        <view class="emp-bar-fill" style="width: {{item.progress}}%"></view>
      </view>
      <view class="emp-foot">
        <text class="emp-rate">完成率 {{item.completionRate}}%</text>
        <text class="arrow">></text>
      </view>
    </view>
  </view>
</view>

<tab-bar active="employees" />
