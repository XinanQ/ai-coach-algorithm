<view class="page">
  <view class="page-head">
    <text class="eyebrow">团队整体分析 · 本周</text>
    <text class="big-title">数据分析</text>
  </view>

  <view class="grid">
    <view class="cell">
      <text class="cv">{{team.completionRate}}%</text>
      <text class="cl">完成率</text>
    </view>
    <view class="cell">
      <text class="cv">{{team.avgScore}}</text>
      <text class="cl">平均评分</text>
    </view>
    <view class="cell">
      <text class="cv">{{team.recommendRate}}%</text>
      <text class="cl">推荐任务完成率</text>
    </view>
    <view class="cell">
      <text class="cv">{{team.highRiskCount}}</text>
      <text class="cl">高风险人数</text>
    </view>
  </view>

  <text class="section-title">员工完成率 Top3</text>
  <view class="bars">
    <view class="bar-row" wx:for="{{completionTop3}}" wx:key="name">
      <text class="bar-name">{{item.name}}</text>
      <view class="bar">
        <view class="bar-fill" style="width: {{item.value}}%"></view>
      </view>
      <text class="bar-val">{{item.value}}%</text>
    </view>
  </view>

  <text class="section-title">能力达成 Top3</text>
  <view class="bars">
    <view class="bar-row" wx:for="{{abilityTop3}}" wx:key="name">
      <text class="bar-name wide">{{item.name}}</text>
      <view class="bar">
        <view class="bar-fill" style="width: {{item.pct}}%"></view>
      </view>
      <text class="bar-val">{{item.count}}人</text>
    </view>
  </view>
</view>

<tab-bar active="analysis" />
