page {
  background: var(--bg);
}
.field {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.label {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}
.input {
  font-size: 32rpx;
  color: var(--text);
  height: 52rpx;
}
.ph {
  color: #b5b5b5;
}
.seg2 {
  display: flex;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  overflow: hidden;
}
.seg2-item {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
}
.seg2-item.active {
  color: #fff;
  background: var(--primary);
}
.hint {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 16rpx;
}
.picker {
  font-size: 30rpx;
  color: var(--text);
  padding: 6rpx 0;
}
.dims {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.dim {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
}
.dim.on {
  border-color: var(--primary);
}
.dim-text {
  font-size: 28rpx;
}
.check {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
}
.submit-btn {
  margin-top: 40rpx;
  height: 96rpx;
  line-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.submit-btn::after {
  border: none;
}
