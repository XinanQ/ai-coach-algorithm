/**index.wxss**/
page {
  background: var(--bg);
}
.container {
  padding: 0 32rpx calc(140rpx + env(safe-area-inset-bottom));
}
.header {
  background: var(--gradient);
  margin: 0 -32rpx 32rpx;
  padding: 72rpx 32rpx 96rpx;
  display: flex;
  flex-direction: column;
  color: #fff;
}
.greeting {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.1;
}
.sub {
  font-size: 26rpx;
  opacity: 0.7;
  margin-top: 16rpx;
}

/* 本月积分完成度卡片 */
.score-card {
  display: flex;
  align-items: center;
  gap: 36rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  padding: 36rpx;
  margin-top: -64rpx;
  margin-bottom: 24rpx;
}
.ring {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ring-inner {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: var(--surface);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.ring-percent {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: -1rpx;
  line-height: 1;
}
.ring-label {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}
.score-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.score-eyebrow {
  font-size: 24rpx;
  color: var(--text-secondary);
  letter-spacing: 2rpx;
}
.score-main {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
}
.score-value {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: -2rpx;
  line-height: 1;
}
.score-target {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-left: 12rpx;
}
.score-remain {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 18rpx;
}
.card-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}
.card {
  flex: 1;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.card-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary);
}
.card-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}
.sections {
  display: flex;
  flex-direction: column;
}
.section {
  background: var(--surface);
  padding: 44rpx 8rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid var(--border);
}
.section:first-child {
  border-top: 1rpx solid var(--border);
}
.section-left {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}
.section-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 10rpx;
}
.arrow {
  color: var(--text);
  font-size: 30rpx;
}
